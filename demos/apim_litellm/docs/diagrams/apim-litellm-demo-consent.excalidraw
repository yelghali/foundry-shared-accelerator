    {"id":"models-note","type":"text","x":40,"y":960,"width":1360,"height":40,"text":"Models: native pod federation. Service identities need no OBO apps. Delegated MCP: native OBO; agents: custom OBO.","fontSize":16,"fontFamily":2,"strokeColor":"#000000"}
