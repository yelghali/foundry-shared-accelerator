    {"id":"gateway-text","type":"text","x":555,"y":255,"width":390,"height":160,"text":"Confidential gateway app\nAPI: access_as_user\nClient: downstream OBO\nDistinct from gateway pod identity","fontSize":16,"fontFamily":2,"strokeColor":"#000000","containerId":"gateway","textAlign":"center","verticalAlign":"middle"},
