# Use the infra deployment_contract output. Azure workload identity webhook
# supplies AZURE_TENANT_ID, AZURE_CLIENT_ID and AZURE_FEDERATED_TOKEN_FILE.
# Native virtual keys require litellm-auth in EACH gateway namespace:
# master-key (sk-...), database-url (PostgreSQL), postgres-password (DB bootstrap).
# launch.py fails closed without durable credentials; pinned LiteLLM CLI runs
# Prisma migrations before serving. Never pass the admin key through APIM.
# All routes authenticate native keys with x-litellm-api-key; Authorization is
# reserved for the real user token in user-obo.
# Public is a development test profile; switch to private and re-render/apply.
# Both profiles require gateway/gateway-tls (kubernetes.io/tls; tls.crt + tls.key).
# APIM backend URL MUST be https://<load-balancer-IP> (Service port 443).
# A self-signed certificate is acceptable only in dev: disable APIM backend
# certificate chain/name validation only there, never disable TLS.
# APIM authenticates callers; the gateway separately enforces native virtual
# key grants. Prefer private exposure and source ranges to prevent direct
# gateway access. FastMCP remains ClusterIP (test via /blob/mcp).
EXPOSURE=public
# shared-service | dedicated-application | user-obo
AUTHENTICATION_SCENARIO=shared-service
GATEWAY_NAMESPACE=gateway
GATEWAY_INSTANCE=litellm
GATEWAY_SERVICE_ACCOUNT=litellm
# Dedicated example: gateway-app-alpha / litellm; its own namespace,
# DB/Secret and federated workload identity restrict BOTH models and backends.
# User OBO example: gateway-user-obo / litellm (models still use workload identity).
PUBLIC_DNS_LABEL=fsa-lit1120
TLS_SECRET_NAME=gateway-tls
# Include APIM API suffix so generated agent-card URLs route through APIM.
PROXY_BASE_URL=https://fsa-lit1120-apim.azure-api.net/ai
# Optional comma-separated CIDRs: include developer AND APIM outbound IPs.
# Empty permits public connectivity, but never bypasses native virtual-key auth.
LOAD_BALANCER_SOURCE_RANGES=
TENANT_ID=
LITELLM_CLIENT_ID=
LITELLM_PRINCIPAL_ID=
FASTMCP_CLIENT_ID=
# Optional explicit comma-separated allowlists for shared FastMCP WI clients.
# Both client application ID and principal object ID must match their lists.
MCP_ALLOWED_CLIENT_IDS=
MCP_ALLOWED_PRINCIPAL_IDS=
# Dedicated container-scoped writer used only by the one-shot blob-seed Job.
BLOB_SEED_CLIENT_ID=
# Service-identity FastMCP audience. Production uses a dedicated MCP API.
# The development management audience additionally requires the explicit
# allowed LiteLLM managed-identity client and principal IDs.
MCP_TOKEN_AUDIENCE=https://management.azure.com
MCP_TOKEN_SCOPE=https://management.azure.com/.default
AZURE_API_BASE=https://aif-agentgw-xlen9.openai.azure.com/
AZURE_MODEL=azure/gpt-4o-mini
AZURE_API_VERSION=2024-10-21
MODEL_ALIAS=enterprise-chat
LITELLM_IMAGE=
FASTMCP_IMAGE=
BLOB_ACCOUNT_URL=
BLOB_CONTAINER=
# Exact administrator-owned invocation/discovery bases. Rendered A2A URLs must
# be HTTPS without credentials/query; endpoint protocol compatibility is fixed
# inside the pinned gateway integrations, not supplied by consumers.
FOUNDRY_A2A_URL=
FOUNDRY_A2A_CARD_URL=
FOUNDRY_DECLARATIVE_A2A_URL=
FOUNDRY_DECLARATIVE_A2A_CARD_URL=
# user-obo only: native MCP uses entra_obo; in-process agent code exchanges the real user
# token. APIM copies Authorization into x-a2a-hosted-authorization and
# x-a2a-declarative-authorization, overriding caller-supplied values.
# SecretProviderClass litellm-obo must project obo-client-secret from Key Vault.
# The secret value is never rendered into manifests.
OBO_CLIENT_ID=
# Actual v2 access-token aud is the gateway application GUID, not its API URI.
OBO_INPUT_AUDIENCE=
OBO_ALLOWED_CLIENT_IDS=
OBO_ALLOWED_PRINCIPAL_IDS=
OBO_REQUIRED_SCOPE=access_as_user
MCP_REQUIRED_SCOPE=tools.read
# Private model-backed profile: normally supplied by prepare --private-demo
# --enable-agent-responses. Hosted and declarative are the only A2A aliases.
ENABLE_AGENT_RESPONSES=false
PRIVATE_FOUNDRY_DEMO=false
FOUNDRY_PROMPT_RESPONSES_BASE=
FOUNDRY_HOSTED_RESPONSES_BASE=
# Optional if the prompt agent's model differs from AZURE_MODEL.
PROMPT_AGENT_MODEL=
# Internal-only MCP LB and network-policy ingress from this delegated subnet.
# The current demo hop is HTTP within the VNet; use trusted HTTPS in production.
FOUNDRY_AGENT_SUBNET_CIDR=
# Explicit hosted runtime identity allowlists, not consumer/user identities.
MCP_FOUNDRY_CLIENT_IDS=
MCP_FOUNDRY_PRINCIPAL_IDS=
