<policies>
  <inbound>
    <base />
%{ if user_obo ~}
    <validate-azure-ad-token tenant-id="${tenant_id}" failed-validation-httpcode="401" failed-validation-error-message="A delegated user token for this gateway is required">
      <audiences><audience>${user_obo_audience}</audience></audiences>
      <required-claims>
        <claim name="scp" match="any" separator=" "><value>access_as_user</value></claim>
      </required-claims>
    </validate-azure-ad-token>
%{ endif ~}
    <choose>
      <when condition='@(!System.Text.RegularExpressions.Regex.IsMatch(context.Request.OriginalUrl.Path, "^/${path}/(v1/(chat/completions|responses|models)|blob/mcp|a2a/(echo|declarative)(/\\.well-known/agent(-card)?\\.json)?)/?$"))'>
        <return-response><set-status code="403" reason="Only published AI routes are allowed" /></return-response>
      </when>
      <when condition='@(!context.Request.Headers.ContainsKey("x-litellm-api-key"))'>
        <return-response><set-status code="401" reason="LiteLLM virtual key required" /></return-response>
      </when>
    </choose>
    <set-backend-service backend-id="${backend_id}" />
    <set-header name="x-litellm-user-id" exists-action="delete" />
    <set-header name="x-litellm-team-id" exists-action="delete" />
    <set-header name="x-litellm-user-role" exists-action="delete" />
%{ if user_obo ~}
    <set-header name="x-a2a-echo-authorization" exists-action="override">
      <value>@(context.Request.Headers.GetValueOrDefault("Authorization", ""))</value>
    </set-header>
    <set-header name="x-a2a-declarative-authorization" exists-action="override">
      <value>@(context.Request.Headers.GetValueOrDefault("Authorization", ""))</value>
    </set-header>
%{ else ~}
    <set-header name="x-a2a-echo-authorization" exists-action="delete" />
    <set-header name="x-a2a-declarative-authorization" exists-action="delete" />
%{ endif ~}
  </inbound>
  <backend><forward-request timeout="240" buffer-response="false" /></backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
