FROM ghcr.io/astral-sh/uv:0.11.7@sha256:240fb85ab0f263ef12f492d8476aa3a2e4e1e333f7d67fbdd923d00a506a516a AS uvbin
FROM ghcr.io/berriai/litellm:v1.110.2
USER root
WORKDIR /app/scenario
COPY --from=uvbin /uv /usr/local/bin/uv
COPY requirements-gateway.txt .
RUN uv pip install --python /app/.venv/bin/python --no-cache -r requirements-gateway.txt
COPY identity.py obo.py mcp_workload.py foundry_a2a.py agent_responses.py request_policy.py config.yaml launch.py ./
ENV PYTHONPATH=/app/scenario
EXPOSE 4000
ENTRYPOINT ["python", "/app/scenario/launch.py"]
CMD ["--config", "/app/scenario/config.yaml", "--host", "0.0.0.0", "--port", "4000"]
