    {"id":"mcp-auth-note","type":"text","x":40,"y":885,"width":1360,"height":35,"text":"A/B MCP: custom sidecar in LiteLLM pod. C MCP: native LiteLLM user OBO; no MCP auth sidecar.","fontSize":14,"fontFamily":2,"strokeColor":"#000000"},
    {"id":"agent-auth-note","type":"text","x":40,"y":920,"width":1360,"height":35,"text":"C agent OBO: our Python inside LiteLLM, not native agent OBO or a sidecar. Agent calls go directly to Foundry.","fontSize":14,"fontFamily":2,"strokeColor":"#000000"},
